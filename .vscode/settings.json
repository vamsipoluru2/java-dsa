{
    "code-runner.runInTerminal": true,
    "code-runner.fileDirectoryAsCwd": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.executorMap": {
        "java": "cmd /c \"cd /d $dir && javac -g -d %TEMP%\\jrun $fileName && java -cp %TEMP%\\jrun $fileNameWithoutExt\""
    },
    "java.debug.settings.enableRunDebugCodeLens": false,
    "java.debug.settings.onBuildFailureProceed": true,
    "java.debug.settings.forceBuildBeforeLaunch": true,
    "java.autobuild.enabled": true,
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.project.sourcePaths": [
        "."
    ],
    "java.project.outputPath": "bin",
    "java.errors.incompleteClasspath.severity": "ignore",
    "java.compile.nullAnalysis.mode": "disabled",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-21",
            "path": "C:\\Program Files\\Eclipse Adoptium1\\jdk-21.0.3.9-hotspot",
            "default": true
        },
        {
            "name": "JavaSE-11",
            "path": "C:\\Program Files\\Eclipse Adoptium\\jdk-11.0.27"
        }
    ]
}
