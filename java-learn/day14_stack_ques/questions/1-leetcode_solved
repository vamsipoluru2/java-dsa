class MyQueue {
        private Stack<Integer> first;
        private Stack<Integer> Second;

    public MyQueue() {
        first=new Stack<>();
            Second=new Stack<>();
    }

    public void push(int x) {
        while (!first.isEmpty()){
                Second.push(first.pop());
            }
            first.push(x);
            while (!Second.isEmpty()){
                first.push(Second.pop());
            }
    }

    public int pop() {
        return first.pop();
    }

    public int peek() {
        return first.peek();
    }

    public boolean empty() {
        return first.isEmpty();
    }
}

