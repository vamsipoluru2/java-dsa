//https://leetcode.com/problems/reverseannummber-nodes-in-k-group/
class Solution {
   public ListNode reverseKGroup(ListNode head, int k) {
        if(k<=1||head==null){
            return head;
        }

        ListNode dummy = new ListNode(0); // Dummy node simplifies head handling
        dummy.next = head;
        ListNode prev = dummy;
        ListNode current = head;

        while (true) {
            ListNode kth = findKth(current, k); // Find kth node (or null if less than k)
            if (kth == null) { // Less than k nodes remaining, don't reverseannummber
                prev.next = current; // Connect remaining nodes as they are
                break; // Exit the loop
            }

            ListNode nextGroupStart = kth.next; // Store the start of the next group

            // Reverse the k-group
            ListNode newEnd = current; // Tail of the reversed group
            ListNode prevRev = null;
            ListNode currRev = current;
            ListNode nextRev;
            for (int i = 0; i < k; i++) {
                nextRev = currRev.next;
                currRev.next = prevRev;
                prevRev = currRev;
                currRev = nextRev;
            }

            // Connect the reversed group
            prev.next = prevRev; // Connect previous group's tail to reversed head
            newEnd.next = nextGroupStart; // Connect reversed tail to next group

            prev = newEnd; // Move 'prev' to the end of the reversed group
            current = nextGroupStart; // Move 'current' to the start of the next group
        }

        return dummy.next;
    }

    private ListNode findKth(ListNode current, int k) {
        for (int i = 1; current != null && i < k; i++) {
            current = current.next;
        }
        return current; // Returns null if less than k nodes
    }

